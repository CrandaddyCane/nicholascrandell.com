@model List<Percy.Website.Models.FishViewModel>

@{
    ViewData["Title"] = "Fish Collection";
}

<div class="container py-5">

    <header class="mb-4">
        <h1>Fish Collection</h1>

        <p class="lead">
            Animal Crossing Deluxe - GameCube
        </p>

        <p>
            Town: <strong>Maple</strong> |
            Player: <strong>Nick</strong>
        </p>

        <p>
            <span id="donated-count">
                @Model.Count(f => f.IsDonated)
            </span>
            of @Model.Count fish donated.
        </p>
    </header>

    <form id="donation-form">
        @Html.AntiForgeryToken()
    </form>

    <div id="donation-message"
         class="alert d-none"
         role="status"
         aria-live="polite">
    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-striped table-hover">

            <thead>
                <tr>
                    <th scope="col">Donated</th>
                    <th scope="col">Fish Name</th>
                    <th scope="col">Location</th>
                    <th scope="col">Shadow Size</th>
                    <th scope="col">Sell Price</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var fish in Model)
                {
                    <tr>
                        <td class="text-center">
                            <input type="checkbox"
                                   class="form-check-input donation-checkbox"
                                   data-item-id="@fish.MuseumItemID"
                                   checked="@fish.IsDonated"
                                   aria-label="Donated @fish.FishName" />
                        </td>

                        <td>@fish.FishName</td>

                        <td>
                            @(string.IsNullOrWhiteSpace(fish.SpawnLocations)
                                ? "TBD"
                                : fish.SpawnLocations)
                        </td>

                        <td>
                            @(fish.ShadowSize?.ToString() ?? "TBD")
                        </td>

                        <td>
                            @(fish.SellPrice?.ToString("N0") ?? "N/A")
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const checkboxes = document.querySelectorAll(
            ".donation-checkbox"
        );

        const token = document.querySelector(
            '#donation-form input[name="__RequestVerificationToken"]'
        ).value;

        const donatedCount = document.getElementById(
            "donated-count"
        );

        const message = document.getElementById(
            "donation-message"
        );

        function updateCount() {
            donatedCount.textContent =
                document.querySelectorAll(
                    ".donation-checkbox:checked"
                ).length;
        }

        function showError(text) {
            message.textContent = text;
            message.className = "alert alert-danger";
        }

        checkboxes.forEach(function (checkbox) {

            checkbox.addEventListener("change", async function () {

                const itemId = checkbox.dataset.itemId;
                const newValue = checkbox.checked;

                checkbox.disabled = true;
                message.className = "alert d-none";
                message.textContent = "";

                try {
                    const formData = new FormData();

                    formData.append(
                        "museumItemId",
                        itemId
                    );

                    formData.append(
                        "isDonated",
                        newValue.toString()
                    );

                    formData.append(
                        "__RequestVerificationToken",
                        token
                    );

                    const response = await fetch(
                        "/workspace/animal-crossing/fish/donation",
                        {
                            method: "POST",
                            body: formData,
                            credentials: "same-origin"
                        }
                    );

                    if (!response.ok) {
                        throw new Error(
                            "Database update failed."
                        );
                    }

                    const result = await response.json();

                    if (
                        result.success !== true ||
                        result.museumItemId !== Number(itemId) ||
                        result.isDonated !== newValue
                    ) {
                        throw new Error(
                            "Unexpected response from server."
                        );
                    }

                    updateCount();

                } catch (error) {

                    // Restore the previous checkbox state.
                    checkbox.checked = !newValue;

                    showError(
                        "Unable to save donation. Please try again."
                    );

                    console.error(error);

                } finally {
                    checkbox.disabled = false;
                }
            });
        });
    });
</script>
