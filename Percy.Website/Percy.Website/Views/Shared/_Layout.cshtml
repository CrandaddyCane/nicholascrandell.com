
@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "Home";

    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();

    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle | Nick Crandell</title>

    <meta name="description"
          content="The professional portfolio of Nicholas Crandell, featuring professional experience, technical skills, and development projects." />

    <!-- Open Sans typography -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700;800&amp;display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Percy.Website.styles.css"
          asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">

    <!-- Primary navigation -->
    <header class="site-header">
        <nav class="navbar"
             aria-label="Primary navigation">

            <div class="container justify-content-center">
                <ul class="navbar-nav flex-row align-items-center">

                    <!-- Home -->
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                           asp-controller="Home"
                           asp-action="Index"
                           aria-current="@(currentController == "Home" && currentAction == "Index" ? "page" : null)">
                            Home
                        </a>
                    </li>

                    <!-- Portfolio -->
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Home" && currentAction == "Portfolio" ? "active" : "")"
                           asp-controller="Home"
                           asp-action="Portfolio"
                           aria-current="@(currentController == "Home" && currentAction == "Portfolio" ? "page" : null)">
                            Portfolio
                        </a>
                    </li>

                    @if (isAuthenticated)
                    {
                        <!-- Workshop -->
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Workspace" ? "active" : "")"
                               asp-controller="Workspace"
                               asp-action="Index"
                               aria-current="@(currentController == "Workspace" ? "page" : null)">
                                WIP
                            </a>
                        </li>

                        <!-- Logout -->
                        <li class="nav-item">
                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="m-0">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="nav-link border-0 bg-transparent">
                                    Logout
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <!-- Login -->
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Account" && currentAction == "Login" ? "active" : "")"
                               asp-controller="Account"
                               asp-action="Login"
                               aria-current="@(currentController == "Account" && currentAction == "Login" ? "page" : null)">
                                Login
                            </a>
                        </li>
                    }

                </ul>
            </div>
        </nav>
    </header>

    <!-- Main content -->
    <main id="main-content"
          class="container flex-grow-1"
          role="main">

        @RenderBody()

    </main>

    <!-- Footer -->
    <footer class="site-footer border-top py-4 mt-auto">
        <div class="container">

            <nav aria-label="Footer navigation">
                <ul class="nav justify-content-center">

                    <!-- Contact -->
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Contact">
                            Contact
                        </a>
                    </li>

                    <!-- LinkedIn -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="https://www.linkedin.com/in/nick-crandell-7361a62b4"
                           target="_blank"
                           rel="noopener noreferrer">
                            LinkedIn
                        </a>
                    </li>

                </ul>
            </nav>

            <div class="text-center text-muted mt-3">
                <small>
                    &copy; @DateTime.Now.Year Nicholas Crandell.
                    All rights reserved.
                </small>
            </div>

        </div>
    </footer>

    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
