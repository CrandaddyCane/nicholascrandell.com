
@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "Home";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle | Nick Crandell</title>

    <meta name="description"
          content="The professional portfolio of Nicholas Crandell, featuring professional experience, technical skills, and development projects." />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Percy.Website.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- Site Header -->
    <header>
        <nav class="navbar navbar-expand-md navbar-light bg-light border-bottom">
            <div class="container">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    NWC
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#primaryNavigation"
                        aria-controls="primaryNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="primaryNavigation">

                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Portfolio">
                                Portfolio
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Login">
                                Login
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Page Content -->
    <main id="main-content"
          role="main"
          class="container py-5">

        @RenderBody()

    </main>

    <!-- Site Footer -->
    <footer class="border-top py-4 mt-5">
        <div class="container">

            <nav aria-label="Footer navigation">
                <ul class="nav justify-content-center">

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Contact">
                            Contact
                        </a>
                    </li>

                    <li class="nav-item">
    <a class="nav-link"
       href="~/documents/Nicholas_Crandell_Resume.pdf"
       download="Nicholas_Crandell_Resume.pdf">
        Download Resume
    </a>
</li>

<li class="nav-item">
    <a class="nav-link"
       href="https://github.com/CrandaddyCane"
       target="_blank"
       rel="noopener noreferrer">
        GitHub
    </a>
</li>

                
<li class="nav-item">
    <a class="nav-link"
       href="https://www.linkedin.com/in/nick-crandell-7361a62b4"
       target="_blank"
       rel="noopener noreferrer">
        LinkedIn
    </a>
</li>



           

                    @* LinkedIn will be added when its URL is confirmed. *@

                </ul>
            </nav>

            <div class="text-center text-muted mt-3">
                <small>
                    &copy; @DateTime.Now.Year Nicholas Crandell.
                    All rights reserved.
                </small>
            </div>

        </div>
    </footer>

    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
