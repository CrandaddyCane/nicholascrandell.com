@using Percy.Website.Models

@{
    ViewData["Title"] = "Workshop";

    var projectManagement = new CardCollectionViewModel
    {
        CollectionId = "project-management-cards",
        DisplayVariant = "horizontal",
        ShowNavigation = false,
        Cards = new List<ProjectCardViewModel>
        {
            new ProjectCardViewModel
            {
                Description = "A unified platform for project management, collaboration, tasks, documents, and workflows.",
                ButtonText = "Coming Soon",
                IsEnabled = false
            }
        }
    };

    var housingTools = new CardCollectionViewModel
    {
        CollectionId = "housing-tools-cards",
        DisplayVariant = "horizontal",
        ShowNavigation = false,
        Cards = new List<ProjectCardViewModel>
        {
            new ProjectCardViewModel
            {
                Description = "Explore housing market data, property trends, and analytical tools.",
                ButtonText = "Coming Soon",
                IsEnabled = false
            }
        }
    };

    var gameTrackers = new CardCollectionViewModel
    {
        CollectionId = "video-game-cards",
        DisplayVariant = "compact",
        ShowNavigation = true,
        Cards = new List<ProjectCardViewModel>
        {
            new ProjectCardViewModel
            {
                Title = "Animal Crossing",
                Description = "First one goes to Blathers",
                ImageUrl = "/images/games/card-ac.jpg",
                ButtonText = "Open",
                Url = "/workspace/animal-crossing",
                IsEnabled = true,
            },
            new ProjectCardViewModel
            {
                Title = "Satisfactory",
                Description = "The factory must grow",
                ImageUrl = "/images/games/card-satisfactory.jpg",
                ButtonText = "Coming Soon",
                IsEnabled = false,
            },
            new ProjectCardViewModel
            {
                Title = "Pokémon",
                Description = "Gotta catch 'em all",
                ImageUrl = "/images/games/card-pokeemans.jpg",
                ButtonText = "Coming Soon",
                IsEnabled = false,
            },
        }
    };
}

<div class="container py-5">

    <header class="mb-4">
        <h1>Workshop</h1>
    </header>

    <section class="card p-4 mb-4"
             aria-labelledby="project-management-heading">

        <h2 id="project-management-heading" class="mb-3">
            Project Management Software
        </h2>

        @await Component.InvokeAsync(
            "CardCollection",
            new { model = projectManagement })

    </section>

    <section class="card p-4 mb-4"
             aria-labelledby="housing-heading">

        <h2 id="housing-heading" class="mb-3">
            Housing Market Tool
        </h2>

        @await Component.InvokeAsync(
            "CardCollection",
            new { model = housingTools })

    </section>

    <section class="card p-4 mb-4"
             aria-labelledby="games-heading">

        <h2 id="games-heading" class="mb-3">
            Video Game Trackers &amp; Assistants
        </h2>

        @await Component.InvokeAsync(
            "CardCollection",
            new { model = gameTrackers })

    </section>

</div>
