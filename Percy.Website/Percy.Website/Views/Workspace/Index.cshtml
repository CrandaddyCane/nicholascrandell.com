@{
    ViewData["Title"] = "Workspace";
}

<div class="container py-5">

    <header class="mb-5">
        <h1>My Workspace</h1>

        <p class="lead">
            Personal projects, experiments, and development tools.
        </p>

        <p class="text-muted">
            My private development workspace.
        </p>
    </header>

    <hr />

    <section class="mt-5" aria-labelledby="projects-heading">

        <h2 id="projects-heading" class="mb-4">
            Projects
        </h2>

        <div class="row g-4">

            <!-- Video Game Trackers -->
            <div class="col-12 col-md-6">

                <div class="card h-100">

                    <div class="card-body d-flex flex-column">

                        <h3 class="h5">
                            Video Game Trackers
                        </h3>

                        <p class="text-muted">
                            In Development
                        </p>

                        <p>
                            Track progress, accomplishments, and
                            activities across Animal Crossing,
                            Pokémon, and Satisfactory.
                        </p>

                        <div class="mt-auto pt-3">
                            <a href="/workspace/games"
                               class="btn btn-primary">
                                Open Project
                            </a>
                        </div>

                    </div>

                </div>

            </div>

            <!-- Future Project -->
            <div class="col-12 col-md-6">

                <div class="card h-100">

                    <div class="card-body d-flex flex-column">

                        <h3 class="h5">
                            Project #2
                        </h3>

                        <p class="text-muted">
                            Planned
                        </p>

                        <p>
                            Placeholder for a future project
                            within the workspace.
                        </p>

                        <div class="mt-auto pt-3">
                            <button class="btn btn-outline-secondary"
                                    disabled>
                                Coming Soon
                            </button>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>
