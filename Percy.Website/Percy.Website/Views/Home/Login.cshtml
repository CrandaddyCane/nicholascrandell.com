@{
    ViewData["Title"] = "Login";
}

<section aria-labelledby="login-heading">

    <header class="mb-4">
        <h1 id="login-heading">Login</h1>

        <p class="lead">
            Access the private area of this website.
        </p>
    </header>

    <div class="row">
        <div class="col-12 col-md-6 col-lg-5">

            <div class="card">
                <div class="card-body">

                    <h2 class="h5 mb-3">
                        Account Access
                    </h2>

                    <p>
                        This area will provide secure,
                        password-protected access to private
                        website content.
                    </p>

                    <div class="alert alert-info"
                         role="status">
                        Authentication is currently under
                        development.
                    </div>

                </div>
            </div>

        </div>
    </div>

</section>
