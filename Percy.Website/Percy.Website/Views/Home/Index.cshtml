@{
    ViewData["Title"] = "Home";
}

<partial name="_Hero" />

<section class="home-career" aria-labelledby="career-heading">

    <h2 id="career-heading" class="home-career-heading">
        Career
    </h2>

    <div class="row g-3 home-dashboard">

        <!-- Highlight -->
        <div class="col-12 col-md-6">
            <section class="home-panel h-100"
                     aria-labelledby="highlight-heading">

                <h3 id="highlight-heading" class="home-panel-heading">
                    Highlight
                </h3>

                <a href="https://benaroyahall.org"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="Visit Benaroya Hall website">

                    <div class="home-highlight-image">
                        <img src="~/images/sso-full.jpg"
                             alt="Seattle Symphony performing at Benaroya Hall"
                             loading="lazy" />
                    </div>

                </a>

                <h4 class="home-highlight-title">
                    The Seattle Symphony Orchestra &amp; Benaroya Hall
                </h4>

                <p class="home-highlight-description">
                    Led project management for the development and
                    deployment of a unified website for the Seattle
                    Symphony and Benaroya Hall, integrating Tessitura
                    CRM and Umbraco CMS to optimize user experience
                    and ensure secure data integration.
                </p>

                <div class="home-tags">
                    <span>Agile Project Management</span>
                    <span>Website Implementation</span>
                    <span>Tessitura</span>
                    <span>Umbraco</span>
                    <span>ASP.NET</span>
                </div>

            </section>
        </div>

        <!-- Experience -->
        <div class="col-12 col-md-6">
            <section class="home-panel h-100"
                     aria-labelledby="experience-heading">

                <h3 id="experience-heading" class="home-panel-heading">
                    Experience
                </h3>

                <div class="home-experience-list">

                    <article class="home-experience-entry">
                        <div class="home-experience-item">
                            <img src="~/images/sso-logo.png"
                                 alt=""
                                 class="home-experience-logo" />

                            <div class="home-experience-details">
                                <h4>Seattle Symphony Orchestra</h4>
                                <p>Digital Project Manager</p>
                                <span>2022–Present</span>
                            </div>
                        </div>

                        <div class="home-tags">
                            <span>GA4 &amp; GTM</span>
                            <span>Tessitura</span>
                            <span>Umbraco</span>
                            <span>Sitecore</span>
                            <span>SQL Server</span>
                            <span>API Integration</span>
                            <span>Vendor Coordination</span>
                            <span>Website Delivery</span>
                            <span>Analytics &amp; SEO</span>
                            <span>Cross-functional Projects</span>
                        </div>
                    </article>

                    <article class="home-experience-entry">
                        <div class="home-experience-item">
                            <img src="~/images/trdy.jpeg"
                                 alt=""
                                 class="home-experience-logo" />

                            <div class="home-experience-details">
                                <h4>Dynafios, Inc.</h4>
                                <p>Technical Account Manager</p>
                                <span>2020–2022</span>
                            </div>
                        </div>

                        <div class="home-tags">
                            <span>Client Onboarding &amp; Training</span>
                            <span>BI Software Configuration</span>
                            <span>Reporting &amp; Analytics</span>
                            <span>Translating Client Business Needs</span>
                        </div>
                    </article>

                    <article class="home-experience-entry">
                        <div class="home-experience-item">
                            <img src="~/images/sfb-logo.png"
                                 alt=""
                                 class="home-experience-logo" />

                            <div class="home-experience-details">
                                <h4>Snoqualmie Falls Brewery &amp; Restaurant</h4>
                                <p>Business Manager</p>
                                <span>2018–2020</span>
                            </div>
                        </div>

                        <div class="home-tags">
                            <span>QuickBooks</span>
                            <span>ERP Systems</span>
                            <span>POS Systems</span>
                            <span>Cash Flow</span>
                            <span>Labor Cost Management</span>
                        </div>
                    </article>

                </div>

            </section>
        </div>

        <!-- Fun Projects: entire panel links to Portfolio -->
        <div class="col-12 col-md-6">
            <a asp-controller="Home"
               asp-action="Portfolio"
               class="home-panel home-panel-link h-100"
               aria-label="View portfolio and fun projects">

                <h3 class="home-panel-heading">
                    Fun Projects
                </h3>

                <div class="home-tags home-project-tags">
                    <span>Python</span>
                    <span>SQL Server</span>
                    <span>SSIS</span>
                    <span>SSRS</span>
                    <span>HTML5/CSS/JS</span>
                    <span>C#</span>
                    <span>Java</span>
                    <span>React</span>
                    <span>ASP.NET</span>
                </div>

            </a>
        </div>

        <!-- Education -->
        <div class="col-12 col-md-6">
            <section class="home-panel h-100"
                     aria-labelledby="education-heading">

                <h3 id="education-heading" class="home-panel-heading">
                    Education
                </h3>

                <div class="home-education-item">
                    <h4>Bellevue College</h4>
                    <p>
                        Data Management &amp; Analysis,
                        Business Intelligence, B.A.S.
                    </p>
                    <p>Accounting, A.A.S.</p>
                </div>

            </section>
        </div>

    </div>
</section>
