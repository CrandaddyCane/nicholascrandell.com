@{
    ViewData["Title"] = "Home";
}

<!-- Hero -->
<partial name="_Hero" />

<!-- Professional Experience -->
<section class="py-4 mb-5"
         aria-labelledby="experience-heading">

    <h2 id="experience-heading" class="display-6 fw-bold mb-4">
        Experience
    </h2>

    <div class="d-flex flex-column gap-3">

        <partial name="_ExperienceCard"
                 model='new Percy.Website.Models.ExperienceViewModel
                 {
                     Company = "Seattle Symphony",
                     LogoUrl = "~/images/sso-logo.png",
                     JobTitle = "Digital Project Manager",
                     DateRange = "2023 – Present",
                     Description = "Leading and supporting digital platform operations, website implementations, systems integrations, and cross-functional technical projects.",
                     Technologies = new List<string>
                     {
                         "Tessitura",
                         "Umbraco",
                         "Sitecore",
                         "Analytics"
                     }
                 }' />

<partial name="_ExperienceCard"
         model='new Percy.Website.Models.ExperienceViewModel
         {
             Company = "Seattle Symphony",
             LogoUrl = "~/images/sso-logo.png",
             JobTitle = "Client Relations Manager",
             DateRange = "2022 – 2023",
             Description = "Leading and supporting digital platform operations, website implementations, systems integrations, and cross-functional technical projects.",
             Technologies = new List<string>
                     {
                         "Tessitura",
                         "Umbraco",
                         "Sitecore",
                         "Analytics"
                     }
         }' />
<partial name="_ExperienceCard"
         model='new Percy.Website.Models.ExperienceViewModel
         {
             Company = "Dynafios, Inc",
             LogoUrl = "~/images/trdy.jpeg",
             JobTitle = "Technical Account Manager",
             DateRange = "2019 – 2021",
             Description = "Leading and supporting digital platform operations, website implementations, systems integrations, and cross-functional technical projects.",
             Technologies = new List<string>
                     {
                         "Tessitura",
                         "Umbraco",
                         "Sitecore",
                         "Analytics"
                     }
         }' />

</div>
</section>

<!-- Expertise -->
<section class="py-4 mb-5"
         aria-labelledby="expertise-heading">

    <div class="mb-4">
        <p class="text-uppercase text-primary fw-semibold"
           style="letter-spacing: 0.12em;">
            What I Do
        </p>

        <h2 id="expertise-heading"
            class="display-6 fw-bold">
            Areas of Expertise
        </h2>

        <p class="text-body-secondary">
            A multidisciplinary approach to building,
            managing, and improving digital systems.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-xl-4">
            <article class="card h-100 shadow-sm">
                <div class="card-body p-4">
                    <h3 class="h5 fw-bold mb-3">
                        Web &amp; Application Development
                    </h3>

                    <p class="text-body-secondary">
                        Developing modern web applications
                        and working across frontend,
                        backend, and CMS technologies.
                    </p>

                    <p class="small mb-0">
                        HTML · CSS · JavaScript · C# ·
                        ASP.NET Core MVC · Bootstrap
                    </p>
                </div>
            </article>
        </div>

        <div class="col-md-6 col-xl-4">
            <article class="card h-100 shadow-sm">
                <div class="card-body p-4">
                    <h3 class="h5 fw-bold mb-3">
                        Systems &amp; Integration
                    </h3>

                    <p class="text-body-secondary">
                        Connecting platforms, troubleshooting
                        complex workflows, and coordinating
                        technical implementations.
                    </p>

                    <p class="small mb-0">
                        Sitecore · Umbraco · Tessitura ·
                        APIs · Technical Operations
                    </p>
                </div>
            </article>
        </div>

        <div class="col-md-6 col-xl-4">
            <article class="card h-100 shadow-sm">
                <div class="card-body p-4">
                    <h3 class="h5 fw-bold mb-3">
                        Data &amp; Analytics
                    </h3>

                    <p class="text-body-secondary">
                        Translating data into useful insights
                        through analysis, measurement,
                        and reporting.
                    </p>

                    <p class="small mb-0">
                        SQL · Business Intelligence ·
                        GA4 · GTM · Data Management
                    </p>
                </div>
            </article>
        </div>

        <div class="col-md-6 col-xl-4">
            <article class="card h-100 shadow-sm">
                <div class="card-body p-4">
                    <h3 class="h5 fw-bold mb-3">
                        Technical Project Management
                    </h3>

                    <p class="text-body-secondary">
                        Bridging technical teams and
                        business stakeholders to define
                        requirements, coordinate delivery,
                        and solve implementation challenges.
                    </p>

                    <p class="small mb-0">
                        Agile · Requirements ·
                        Vendor Coordination · Delivery
                    </p>
                </div>
            </article>
        </div>
    </div>
</section>

<!-- Featured Work -->
<section class="py-4 mb-5"
         aria-labelledby="work-heading">

    <div class="mb-4">
        <p class="text-uppercase text-primary fw-semibold"
           style="letter-spacing: 0.12em;">
            Selected Experience
        </p>

        <h2 id="work-heading"
            class="display-6 fw-bold">
            Featured Work
        </h2>

        <p class="text-body-secondary">
            Professional projects and technical development
            experience.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <article class="card h-100 shadow-sm">
                <div class="card-body p-4">
                    <p class="small text-primary fw-semibold mb-2">
                        PROFESSIONAL EXPERIENCE
                    </p>

                    <h3 class="h4 fw-bold">
                        Seattle Symphony
                    </h3>

                    <p class="text-body-secondary">
                        Digital Project &amp; Client Relations Management
                    </p>

                    <p>
                        Supporting digital platform operations,
                        website implementations, ticketing
                        integrations, and cross-functional
                        technical initiatives.
                    </p>
                </div>
            </article>
        </div>

        <div class="col-lg-6">
            <article class="card h-100 shadow-sm">
                <div class="card-body p-4">
                    <p class="small text-primary fw-semibold mb-2">
                        PERSONAL DEVELOPMENT
                    </p>

                    <h3 class="h4 fw-bold">
                        Percy.Website
                    </h3>

                    <p class="text-body-secondary">
                        ASP.NET Core MVC · C# · Razor
                    </p>

                    <p>
                        Building and deploying a full-stack
                        personal portfolio application while
                        developing practical experience with
                        modern web technologies.
                    </p>
                </div>
            </article>
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="Home"
           asp-action="Portfolio"
           class="btn btn-outline-primary">
            View Portfolio
        </a>
    </div>
</section>

<!-- About -->
<section class="py-5 mb-4"
         aria-labelledby="about-heading">

    <div class="row">
        <div class="col-lg-9">
            <p class="text-uppercase text-primary fw-semibold"
               style="letter-spacing: 0.12em;">
                About Me
            </p>

            <h2 id="about-heading"
                class="display-6 fw-bold mb-4">
                Curious by nature.
                Technical by inclination.
            </h2>

            <p class="lead">
                I like understanding how things work,
                why they break, and how they can be better.
            </p>

            <p class="text-body-secondary">
                My background spans digital project management,
                data management and analysis, content management
                systems, and web platform implementation.
            </p>

            <p class="text-body-secondary">
                I'm particularly interested in opportunities
                that combine technical problem-solving,
                systems architecture, application development,
                and collaboration with people.
            </p>
        </div>
    </div>
</section>
