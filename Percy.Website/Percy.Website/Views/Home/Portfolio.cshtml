@{
    ViewData["Title"] = "Portfolio";
}

<section aria-labelledby="portfolio-heading">

    <header class="mb-5">
        <h1 id="portfolio-heading">Portfolio</h1>

        <p class="lead">
            A collection of technical projects, applications,
            and professional case studies.
        </p>

        <p>
            Explore my work in web application development,
            data management, systems integration,
            and digital technology.
        </p>
    </header>

    <section aria-labelledby="projects-heading">

        <h2 id="projects-heading" class="mb-4">
            Featured Projects
        </h2>

        <div class="row row-cols-1 row-cols-md-2 g-4">

            <!-- F1Archive -->
            <div class="col">
                <article class="card h-100">
                    <div class="card-body">

                        <h3 class="card-title h5">
                            F1Archive
                        </h3>

                        <p class="card-text">
                            An ASP.NET Core MVC application exploring
                            Formula 1 historical data through
                            third-party API integration.
                        </p>

                        <p class="small text-muted">
                            C# | ASP.NET Core MVC | REST API
                        </p>

                        <span class="badge bg-secondary">
                            In Development
                        </span>

                    </div>
                </article>
            </div>

            <!-- Future Projects -->
            <div class="col">
                <article class="card h-100">
                    <div class="card-body">

                        <h3 class="card-title h5">
                            Additional Projects
                        </h3>

                        <p class="card-text">
                            Future applications and technical
                            demonstrations will be featured here
                            as development progresses.
                        </p>

                        <span class="badge bg-secondary">
                            Planned
                        </span>

                    </div>
                </article>
            </div>

        </div>

    </section>

</section>
